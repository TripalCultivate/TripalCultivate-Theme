<?php
use \Drupal\block\Entity\Block;
use Drupal\Core\Session\AccountInterface;

/**
 * Implements hook_form_alter().
 *
 * This will add JS color picker library to form that add/edit tile block content
 * in the dependent theme - Tripal Cultivate Theme.
 *
 * The color picker will launch a color picker window to allow user to pick a color
 * that will be transferred to the field in hex code value.
 *
 * @see libraries.
 */
function trpcultivatetheme_companion_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $tile_block = 'block_content_trpcultivatetheme_tile_block';

  if ($form_id == $tile_block . '_form' || $form_id == $tile_block . '_edit_form') {
    // When the form is to add or edit a tile block content, attach color picker library.
    $form['#attached']['library'][] = 'trpcultivatetheme_companion/trpcultivatetheme-color-picker';
    $form['trpcultivatetheme_tile_bgcolor']['#attributes']['style'] = 'width: 200px';
  } 
}

/**
 * Implements hook_block_access().
 *
 * Remind user when adding a non-compatible content into tiles region.
 * @see api.drupal.org/api/drupal/core%21modules%21block%21block.api.php/function/hook_block_access/10
 */
function trpcultivatetheme_companion_block_access(Block $block, $operation, AccountInterface $account) {
  // Fetch all the regions of trpcultivatetheme (default theme) and filter out other
  // regions defined by the base theme. Focus on tile regions only.

  $def_theme = \Drupal::config('system.theme')
    ->get('default');
            
  $regions = system_region_list($def_theme);
  
  // Extract only the trpcultivatetheme_tiles custom regions.
  $trpcultivatetheme_regions = [];
  
  // Watch for contents placed into tiles and funders regions.
  foreach($regions as $region_name => $_) {
    if (preg_match('/^' . $def_theme . '(_tiles|_contents_funders)/', $region_name)) {
      array_push($trpcultivatetheme_regions, $region_name);
    }
  }
  
  // The region the content is about to be placed.
  $block_region = $block->getRegion();

  if ($block_region && in_array($block_region, $trpcultivatetheme_regions) && $operation == 'update') {
    // When updating a region by placing a content block into any of the tiles region.
    
    // The id of the content.
    $block_id = $block->getPluginId();

    if ($block_id) {
      // @debug dpm($block);

      // Ensure that only tile block contents get processed.
      $block_dependencies = $block->getDependencies();
      $is_not_compatible = FALSE;
      
      // Tile block content has content key in block dependencies (#dependencies) object,
      // test if block had content and if content was of type tile/funders block.
      if (isset($block_dependencies['content'])) {
        // Has content.
        if (!str_contains($block_dependencies['content'][0], 'trpcultivatetheme_tile_block')) {
          $is_not_compatible = TRUE;
        }
      }
      else {
        // No content.
        $is_not_compatible = TRUE;
      }

      if ($is_not_compatible) {
        $error_message = 'A non-compatible content was added to ' .  ucwords(str_replace('_', ' ', $block_region)) . ' region. ';
        $error_message .= 'BLOCK: '. ucwords(str_replace('_', ' ', $block_id));

        // Logs an error
        \Drupal::logger('trpcultivatetheme_companion')
          ->error($error_message);
        
        // Warns user.
        \Drupal::messenger()
          ->addWarning(t($error_message));
      } 
    }
  }
}