{% extends "block.html.twig" %}
{#
/**
 * @file
 * Tripal Cultivate Theme implementation for a banner tall tile block.
 * Tiie section layout:
 * _______________
 * |      | X |__|
 * |      |___|__|
 * |______|______|
 *
 * Available variables:
 * - trpcultivatetheme_tiles_banner_tall: (array) contains raw unformatted values entered into fields.
 *
 * Keys: to access, use . notation ie. trpcultivatetheme_tiles_banner_tall.title for title field value or
 * trpcultivatetheme_tiles_banner_tall.link.url for link url field value.
 *
 * - title: Tile title text.
 * - link: (array) Tile link. This value has link url (url key) and link text value (text key).
 * - coverimg: Tile cover image.
 * - bgcolor: (array) Tile background color. This value has hex value (hex key) and rgb value (rgb key.)
 *
 * @see hook_preprocess_block() implementation in .theme.
 *
 * NOTE: this tile uses bgcolor field to set the tile background colour.
 *
 * Slide layout:
 * <div>
 *   Markup for context menu
 *   Generated by base theme
 * </div>
 *
 * <div>
 *   <a> 
 *     <div> 
 *       Tile Title
 *       <span>Link</span>
 *     </div>
 *   </a> 
 * </div>
 */
#}

{% block content %}
  {# Cover image of the slide #}
  {% set file_url = trpcultivatetheme_tiles_banner_tall.coverimg %}

  <!-- Base theme will append additional markup to this area //-->

  <div class="tripalcultivate-theme-tiles-banner-tall" style="background-image: url('{{ file_url }}'); background-color: {{ trpcultivatetheme_tiles_banner_tall.bgcolor.hex }}">    
    <a href="{{ trpcultivatetheme_tiles_banner_tall.link.url }}" title="{{ trpcultivatetheme_tiles_banner_tall.title}}" target="_blank">
      <div>
        {{ trpcultivatetheme_tiles_banner_tall.title }}
        <span>{{ trpcultivatetheme_tiles_banner_tall.link.text }}</span>  
      </div>
    </a>
  </div>
{% endblock %}