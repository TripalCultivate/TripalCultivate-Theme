{% extends "block.html.twig" %}
{#
/**
 * @file
 * Tripal Cultivate Theme implementation for a large half tile block.
 * Tiie section layout:
 * _______________
 * |      |   |__|
 * |  X   |___|__|
 * |______|______|
 *
 * Available variables:
 * - trpcultivatetheme_tiles_large_half: (array) contains raw unformatted values entered into fields.
 *
 * Keys: to access, use . notation ie. trpcultivatetheme_tiles_large_half.title for title field value or
 * trpcultivatetheme_tiles_large_half.link.url for link url field value.
 *
 * - title: Tile title text.
 * - link: (array) Tile link. This value has link url (url key) and link text value (text key).
 * - coverimg: Tile cover image.
 * - bgcolor: Tile background color.
 *
 * @see hook_preprocess_block() implementation in .theme.
 *      css/components/slider.css
 *
 * NOTE: this tile does not use bgcolor field value since each slide will
 * will use the cover image to fill the entire area of the tile.
 *
 * Slide layout:
 * <div>
 *   Markup for context menu
 *   Generated by base theme
 * </div>
 *
 * <div>
 *   <a> 
 *     <div> 
 *       Tile Title
 *       <span>Link</span>
 *     </div>
 *   </a> 
 * </div>
 */
#}

{% block content %}
  {# Cover image of the slide #}
  {% set file_url = trpcultivatetheme_tiles_large_half.coverimg %}
  
  <!-- Base theme will append additional markup to this area //-->

  <div class="tripalcultivate-theme-tiles-large-half" style="background-image: url('{{ file_url }}');">
    <div class="tripalcultivate-theme-tiles-slider-slide-item">
      <a href="{{ trpcultivatetheme_tiles_large_half.link.url }}" title="{{ trpcultivatetheme_tiles_large_half.title }}" target="_blank">
        
        {# Inspect RGB value of background color if provided to apply transparency setting. #}
        {% set bg = trpcultivatetheme_tiles_large_half.bgcolor.rgb ? 'rgba(' ~ trpcultivatetheme_tiles_large_half.bgcolor.rgb ~ ',0.4);' : '' %}
        
        <div style="background: {{ bg }}">
          {{ trpcultivatetheme_tiles_large_half.title }}
          <span>{{ trpcultivatetheme_tiles_large_half.link.text }}</span>
        </div>

      </a>
    </div>
  </div>
{% endblock %}