{% extends "block.html.twig" %}
{#
/**
 * @file
 * Tripal Cultivate Theme implementation for a standard top tile block.
 * Tiie section layout:
 * _______________
 * |      |   |x_|
 * |      |___|__|
 * |______|______|
 *
 * Available variables:
 * -
 */
#}

{% block content %}
  {# Cover image of the slide #}
  {% set file_url = trpcultivatetheme_tiles_standard_bottom.coverimg %}

  <!-- Base theme will append additional markup to this area //-->

  <div class="tripalcultivate-theme-tiles-standard-bottom" style="background-image: url('{{ file_url }}'); background-color: {{ trpcultivatetheme_tiles_standard_bottom.bgcolor.hex }}">    

    <a href="{{ trpcultivatetheme_tiles_standard_bottom.link.url }}" title="{{ trpcultivatetheme_tiles_standard_bottom.title}}" target="_blank">
    {{ trpcultivatetheme_tiles_standard_bottom.link.text }}
    </a>

  </div>


{% endblock %}