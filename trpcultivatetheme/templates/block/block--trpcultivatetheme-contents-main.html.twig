{% extends "block.html.twig" %}
{#
/**
 * @file
 * Tripal Cultivate Theme implementation for main content.
 *
 * Available variables:
 * - content_region: The region a content black was placed.
 *
 * Content layout:
 * <div>
 *   Markup for context menu
 *   Generated by base theme
 * </div>
 *
 * <div>
 *   <hr>
 *   <h3>
 *     Content title or label
 *     Display title configuration must be checked in configure block, otherwise
 *     this will just be a horizontal line.
 *   </h3> 
 *   
 *   <div>
 *     Theme content:
 *     <div>
 *       <div>
 *         Article/content left.
 *         <article>
 *           <h4>Title</h4>
 *           <p>Summary text</p>
 *         </article>
 *       </div>
 *        
 *       <div>
 *         Article/content right.
 *         <article>
 *           <h4>Title</h4>
 *           <p>Summary text</p>
 *         </article>
 *       </div>
 *     </div>
 *
 *     Other content:
 *     Content/article
 *   </div>
 * </div>
 */
#}

{% block content %}
  <div class="tripalcultivate-theme-content-main-content-section">    
    <hr class="tripalcultivate-theme-horizontal-rule" />
    <h3 class="tripalcultivate-theme-content-header">
      {{ label }}
    </h3>
    
    <div>
      {# If content has left and right article/text, theme content, otherwise load content. #}
      {% if content.trpcultivatetheme_content_title1 and content.trpcultivatetheme_content_title1 %}
        <div class="tripalcultivate-theme-double-columns-wide tripalcultivate-theme-content-articles">
          <div class="tripalcultivate-theme-tiles-half-column">
            <article>  
              <h4>{{ content.trpcultivatetheme_content_title1 }}</h4>
              <p>{{ content.trpcultivatetheme_content_text1 }}</p>
            </article> 
          </div>
          <div class="tripalcultivate-theme-tiles-half-column">
            <article>
              <h4>{{ content.trpcultivatetheme_content_title2 }}</h4>
              <p>{{ content.trpcultivatetheme_content_text2 }}</p>
            </article>
          </div>
        </div>
      {% else %}
        {{ content }}
      {% endif %}
    </div>
  </div>
{% endblock %}