{% extends "block.html.twig" %}
{#
/**
 * @file
 * Tripal Cultivate Theme implementation for a standard bottom tile block.
 * Tiie section layout:
 * _______________
 * |      |   |__|
 * |      |___|x_|
 * |______|______|
 *
* Available variables:
 * - trpcultivatetheme_tiles_standard_bottom: (array) contains raw unformatted values entered into fields.
 *
 * Keys: to access, use . notation ie. trpcultivatetheme_tiles_standard_bottom.title for title field value or
 * trpcultivatetheme_tiles_standard_bottom.link.url for link url field value.
 *
 * - title: Tile title text (not in use due space restrictions).
 * - link: (array) Tile link. This value has link url (url key) and link text value (text key).
 * - coverimg: Tile cover image.
 * - bgcolor: (array) Tile background color. This value has hex value (hex key) and rgb value (rgb key.)
 *
 * @see hook_preprocess_block() implementation in .theme.
 *
 * NOTE: this tile uses bgcolor field to set the tile background colour.
 *       Tile is ideal for internal page/link thus the link target attribute is to _self.
 *
 * Slide layout:
 * <div>
 *   Markup for context menu
 *   Generated by base theme
 * </div>
 *
 * <div>
 *   <a> 
 *     <div>
 *       Tile icon image.
 *     </div>
 *     <span>
 *       Link
 *     </span>
 *   </a> 
 * </div>
 */
#}

{% block content %}
  {# Cover image of the slide #}
  {% set file_url = trpcultivatetheme_tiles_standard_bottom.coverimg %}

  <!-- Base theme will append additional markup to this area //-->

  <div class="tripalcultivate-theme-tiles-standard-bottom" style="background-color: {{ trpcultivatetheme_tiles_standard_bottom.bgcolor.hex }}">    
    <a href="{{ trpcultivatetheme_tiles_standard_bottom.link.url }}" title="{{ trpcultivatetheme_tiles_standard_bottom.title}}" target="_self">
      {% if file_url %}
        <div><img src="{{ file_url }}" /></div>
      {% endif %}
      
      <span>
        {{ trpcultivatetheme_tiles_standard_bottom.link.text }}
      </span>
    </a>
  </div>
{% endblock %}
